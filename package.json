{
  "name": "@statecase/root",
  "version": "0.0.0",
  "private": true,
  "description": "Portable encrypted operational context for agents",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @statecase/cli",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:package",
    "cloud:test": "vitest run --config apps/cloud/vitest.config.ts",
    "cloud:dev": "wrangler dev --config apps/cloud/wrangler.jsonc",
    "cloud:deploy": "wrangler deploy --config apps/cloud/wrangler.jsonc",
    "cloud:types": "wrangler types --config apps/cloud/wrangler.jsonc apps/cloud/worker-configuration.d.ts",
    "lint": "oxlint --deny-warnings packages apps scripts test vitest.config.ts",
    "pack:cli": "npm pack --workspace @statecase/cli",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "test:coverage": "vitest run --coverage",
    "uat:remote": "node scripts/uat/daytona-product.mjs",
    "uat:background": "node scripts/uat/background-sync.mjs",
    "uat:native-codex": "node scripts/uat/native-codex.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
