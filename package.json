{
  "name": "@statecase/root",
  "version": "0.0.0",
  "private": true,
  "description": "Portable encrypted operational context for agents",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "lint": "oxlint --deny-warnings packages apps test vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
