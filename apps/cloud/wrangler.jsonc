{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "statecase-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "STATECASE_ENV": "production",
    "STATECASE_ALLOWED_EMAILS": "hi@lumea.dev",
    "BETTER_AUTH_URL": "https://statecase-api.hi-0e6.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "statecase",
      "database_id": "e92ffa3c-dff8-4740-afe2-f7e84081b2b2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "statecase-vaults"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULTS",
        "class_name": "VaultCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VaultCoordinator"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  }
}
