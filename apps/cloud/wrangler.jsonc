{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "statecase-api-mvp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "STATECASE_ENV": "mvp",
    "STATECASE_ALLOWED_EMAILS": "hi@lumea.dev",
    "BETTER_AUTH_URL": "https://statecase-api-mvp.hi-0e6.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "statecase-mvp",
      "database_id": "dda02c36-f32b-458a-89b9-e3ed395a1482",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "statecase-mvp"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULTS",
        "class_name": "VaultCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VaultCoordinator"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  }
}
